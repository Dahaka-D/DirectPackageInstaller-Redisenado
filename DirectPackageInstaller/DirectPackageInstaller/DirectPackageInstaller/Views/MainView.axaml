<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DirectPackageInstaller.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DirectPackageInstaller.Views.MainView"
             Foreground="#F4F7FB"
             Background="#0E1116">
  <Design.DataContext>
    <viewModels:MainViewModel />
  </Design.DataContext>
    <Grid DragDrop.AllowDrop="True" Name="MainViewGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141A24" Padding="14,10,8,0">
            <StackPanel>
                <TextBlock Text="Direct Package Installer" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,0"/>
                <TextBlock Text="Send a PKG straight to your console" FontSize="12" Opacity="0.62" Margin="2,1,0,8"/>
                <Menu Background="Transparent">
                    <MenuItem Header="Options">
                        <MenuItem Header="Proxy Downloads" Name="btnProxyDownload">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding ProxyMode, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Segmented Downloads" Name="btnSegmentedDownload" >
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding SegmentedMode, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="CNL Support" Name="btnCNLService" >
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding CNLService, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="DHCP Server" Name="btnDHCPService" >
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding DHCPService, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="IP Address" Classes="NoChildFocus">
                            <StackPanel Orientation="Horizontal">
                                <Label Grid.Column="0">PS IP</Label>
                                <TextBox Grid.Column="1" Text="{Binding PS4IP, Mode=TwoWay}"></TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Grid.Column="0">PC IP</Label>
                                <TextBox Grid.Column="1" Text="{Binding PCIP, Mode=TwoWay}"></TextBox>
                            </StackPanel>
                        </MenuItem>
                        <MenuItem Header="Debrids">
                            <MenuItem Header="AllDebrid" Classes="NoChildFocus">
                                <StackPanel Orientation="Horizontal">
                                    <Label Grid.Column="0">API Key</Label>
                                    <TextBox Grid.Column="1" Text="{Binding AllDebridApiKey, Mode=TwoWay}" Focusable="True"></TextBox>
                                </StackPanel>
                                <MenuItem Header="Enabled" Padding="10,10,0,10" Name="btnAllDebirdEnabled">
                                    <MenuItem.Icon>
                                        <CheckBox BorderThickness="0" IsChecked="{Binding UseAllDebrid, Mode=TwoWay}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="RealDebrid" Classes="NoChildFocus">
                                <StackPanel Orientation="Horizontal">
                                    <Label Grid.Column="0">API Key</Label>
                                    <TextBox Grid.Column="1" Text="{Binding RealDebridApiKey, Mode=TwoWay}"></TextBox>
                                </StackPanel>
                                <MenuItem Header="Enabled" Padding="10,10,0,10" Name="btnRealDebirdEnabled">
                                    <MenuItem.Icon>
                                        <CheckBox BorderThickness="0" IsChecked="{Binding UseRealDebrid, Mode=TwoWay}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="DebridLink" Classes="NoChildFocus">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="API Key" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Width="150" Text="{Binding DebridLinkApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <MenuItem Header="Enabled" Padding="10,10,0,10" Name="btnDebirdLinkEnabled">
                                    <MenuItem.Icon>
                                        <CheckBox BorderThickness="0" IsChecked="{Binding UseDebridLink, Mode=TwoWay}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="Restart Server" Name="btnRestartServer"/>
                        <MenuItem Header="Exit" Name="btnExit"/>
                    </MenuItem>
                    <MenuItem Header="Packages" IsVisible="False" Name="PackagesMenu">
                        <Separator></Separator>
                        <MenuItem Header="Install All" Name="btnInstallAll"></MenuItem>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#141A24" Padding="12,4,12,12" CornerRadius="0,0,18,18">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" MinHeight="48" Padding="12,0" CornerRadius="12" VerticalContentAlignment="Center" Watermark="PKG url or local file" Text="{Binding CurrentURL, Mode=TwoWay}" Name="tbURL"/>
                <Button Grid.Column="1" MinHeight="48" MinWidth="104" Margin="8,0,0,0" Padding="16,0" CornerRadius="12" VerticalContentAlignment="Center" HorizontalAlignment="Right" Name="btnLoad">Open</Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="12,12,12,8" Padding="8" CornerRadius="16" Background="#171C27">
            <Grid Name="PreviewGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Name="IconBox" Stretch="Uniform" Margin="8"/>
                <GridSplitter Name="MainGridSplitter" Grid.Column="1" Background="#2A3344"></GridSplitter>

                <DataGrid Grid.Column="2" Name="PkgInfoGrid" ItemsSource="{Binding PKGParams}" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Param" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="12,0,12,12" Padding="14,10" CornerRadius="12" Background="#141A24">
            <TextBlock Name="Status" TextWrapping="Wrap" FontSize="13" Opacity="0.9"/>
        </Border>
    </Grid>
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Width" Value="22"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,-6,0,-16"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#3D7EFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5B92FF"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="36"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="MenuItem >> Label">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="MenuItem >> TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Width" Value="180"/>
        </Style>
        <Style Selector="MenuItem.NoChildFocus > MenuItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="StaysOpenOnClick" Value="True"/>
        </Style>
    </UserControl.Styles>
</UserControl>
